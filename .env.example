# Copy to .env and set DB_PASSWORD locally. Never commit .env.
# Use plain KEY=value syntax (no quotes) for Compose and Spring's properties import.
# For passwords containing special characters, prefer OS environment variables.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dartwatch
DB_USERNAME=dartwatch
DB_PASSWORD=
SERVER_PORT=8080
OPENDART_API_KEY=

# Enable only after company synchronization and watch registration.
COLLECTION_ENABLED=false
COLLECTION_INTERVAL=PT10M
COLLECTION_INITIAL_DELAY=PT30S
COLLECTION_INITIAL_DAYS=30
COLLECTION_OVERLAP_DAYS=3
OPENDART_CONNECT_TIMEOUT=5s
OPENDART_READ_TIMEOUT=30s
OPENDART_PAGE_SIZE=100
OPENDART_MAX_PAGES=1000
OPENDART_MAX_RETRIES=2
OPENDART_RETRY_INITIAL_DELAY=PT1S
OPENDART_RETRY_MAX_DELAY=PT10S
OPENDART_RATE_LIMIT_COOLDOWN=PT1H

# Classification (existing A~E lookup)
CLASSIFICATION_BATCH_SIZE=100
CLASSIFICATION_WINDOW_DAYS=30
CLASSIFICATION_RETRY_INTERVAL=PT24H

# SMTP
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Single-user notification
NOTIFICATION_EMAIL_TO=
NOTIFICATION_ENABLED=false
# EMAIL remains selected for compatibility; global NOTIFICATION_ENABLED defaults false.
EMAIL_ENABLED=true
MAIL_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_STARTTLS_REQUIRED=true
MAIL_CONNECT_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_INTERVAL=PT10M
NOTIFICATION_PROCESSING_TIMEOUT=PT10M
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_SCHEDULER_ENABLED=false
NOTIFICATION_SCHEDULER_INTERVAL=PT1M
NOTIFICATION_SCHEDULER_INITIAL_DELAY=PT30S

# Discord
DISCORD_WEBHOOK_URL=
DISCORD_ENABLED=false
DISCORD_CONNECT_TIMEOUT=PT5S
DISCORD_READ_TIMEOUT=PT10S

# Kakao
# Disabled independent module; local connection needs explicit loopback binding.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/integrations/kakao/callback
KAKAO_ENABLED=false
KAKAO_LOCAL_CONNECT_ENABLED=false
KAKAO_TOKEN_ENCRYPTION_KEY=
# Confirm an actual registered Kakao product web origin before configuring links.
# Keep blank if unknown; sender will fail safely without sending.
KAKAO_REGISTERED_WEB_ORIGIN=
KAKAO_MESSAGE_WEB_URL=
KAKAO_CONNECT_TIMEOUT=PT5S
KAKAO_READ_TIMEOUT=PT10S
# For local OAuth only, explicitly set SERVER_ADDRESS=127.0.0.1 in the runtime environment.
