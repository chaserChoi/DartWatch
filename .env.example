# Copy to .env and set DB_PASSWORD locally. Never commit .env.
# Use plain KEY=value syntax (no quotes) for Compose and Spring's properties import.
# For passwords containing special characters, prefer OS environment variables.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dartwatch
DB_USERNAME=dartwatch
DB_PASSWORD=
SERVER_PORT=8080
OPENDART_API_KEY=

# Enable only after company synchronization and watch registration.
COLLECTION_ENABLED=false
COLLECTION_INTERVAL=PT10M
COLLECTION_INITIAL_DELAY=PT30S
COLLECTION_INITIAL_DAYS=30
COLLECTION_OVERLAP_DAYS=3
OPENDART_CONNECT_TIMEOUT=5s
OPENDART_READ_TIMEOUT=30s
OPENDART_PAGE_SIZE=100
OPENDART_MAX_PAGES=1000
OPENDART_MAX_RETRIES=2
OPENDART_RETRY_INITIAL_DELAY=PT1S
OPENDART_RETRY_MAX_DELAY=PT10S
OPENDART_RATE_LIMIT_COOLDOWN=PT1H

# SMTP
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Single-user notification
NOTIFICATION_EMAIL_TO=
NOTIFICATION_ENABLED=false
MAIL_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_STARTTLS_REQUIRED=true
MAIL_CONNECT_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_INTERVAL=PT10M
NOTIFICATION_PROCESSING_TIMEOUT=PT10M
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_SCHEDULER_ENABLED=false
NOTIFICATION_SCHEDULER_INTERVAL=PT1M
NOTIFICATION_SCHEDULER_INITIAL_DELAY=PT30S
